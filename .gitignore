*.swo

# OS
.DS_Store
Thumbs.db

# Go
vendor/

# Sandbox environment overrides (never commit real credentials)
.env
docker/sandbox/.env

# Temporary files
**/tmp

# Workflow output documents
/result/

# Agent working files — not tracked (session state, working records)
.claude/agents/working/working-record/
.claude/agents/working/tmp/
.antigravity/agents/working/working-record/
.antigravity/agents/working/tmp/

# Agent-stage telemetry — runtime measurement only, never product history
.antigravity/agents/tmp/token-metrics/

# Audit workflow reports — runtime output, never committed
.claude/agents/internal/

# Token-trace step logs — per-story runtime observability output, never committed.
# Accumulates over a sprint, cleared at sprint end. NOT the tooling: the
# `tokentrace/` directory (no hyphen, no suffix) holds token_cost.sh + README
# and IS committed. The _sprint suffix keeps the two apart.
.claude/agents/working/token-trace_sprint/
.antigravity/agents/working/token-trace_sprint/

# Python
__pycache__/
*.pyc

# New internal provider state; existing tracked histories are preserved.
.claude/agents/runtime/
.antigravity/agents/runtime/
.codex/agents/runtime/

# Provider-owned operational state (existing tracked histories stay tracked).
.codex/agents/working/
.antigravity/agents/internal/
.codex/agents/internal/
.claude/agents/working/memory/
.claude/agents/working/retros/
.claude/agents/working/reports/
.antigravity/agents/working/memory/
.antigravity/agents/working/retros/
.antigravity/agents/working/reports/
